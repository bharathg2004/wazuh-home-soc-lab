<!-- Local rules -->
<group name="local,syslog,sshd,">

  <rule id="100010" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force attempt: 3+ failed logins from the same source within 2 minutes (lab threshold, built-in rule 5720 uses 8).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,</group>
  </rule>

</group>

<group name="local,firewall,ufw,">

  <!--
    The custom ufw-wsl decoder captures the action field as the literal
    text "UFW BLOCK" (not just "BLOCK"), confirmed via wazuh-logtest.
    Wazuh's built-in rule 4101 looks for action=="DROP" so it never
    matches ufw traffic regardless.
  -->
  <rule id="100020" level="5">
    <if_sid>4100</if_sid>
    <action>UFW BLOCK</action>
    <description>ufw: blocked incoming connection.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>firewall_drop,</group>
  </rule>

  <rule id="100021" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100020</if_matched_sid>
    <same_source_ip />
    <description>ufw: blocked-traffic spike - 3+ blocked connections from the same source within 60 seconds.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>firewall_drop,multiple_drops,</group>
  </rule>

</group>